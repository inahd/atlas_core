  columns: 3,
  align: (col, row) => (auto,auto,auto,).at(col),
  inset: 6pt,
  [Reference], [Method], [Findings],
  [Chute et al. 2024 (Traditional Medicine)],
  [XRD, EDAX, TEM],
  [Reddish-brown color, 10-100 nm quasi-spherical, majority Ag₂S],
