\i\f35\fs28\cf1\insrsid2639816\charrsid12326592 nitya-mukta }{\f35\fs28\cf1\insrsid2639816\charrsid12326592 and }{\i\f35\fs28\cf1\insrsid2639816\charrsid12326592 nitya-baddha. }{\f35\fs28\cf1\insrsid2639816\charrsid12326592 The }{
