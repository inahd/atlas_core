\insrsid11288628  }{\cs337\i\insrsid11288628 ghoram}{\insrsid11288628 \emdash intolerant; }{\cs337\i\insrsid11288628 upeyu\'f1a\'f9}{\insrsid11288628 \emdash achieved; }{\cs337\i\insrsid11288628 surucy\'e4\'f9}{\insrsid11288628 \emdash of Queen Suruci; }{
\cs337\i\insrsid11288628 durvaca\'f9}{\insrsid11288628 \emdash harsh words; }{\cs337\i\insrsid11288628 b\'e4\'ebai\'f9}{\insrsid11288628 \emdash by the arrows; }{\cs337\i\insrsid11288628 na}{\insrsid11288628 \emdash not; }{\cs337\i\insrsid11288628 bhinne}
{\insrsid11288628 \emdash being pierced; }{\cs337\i\insrsid11288628 \'e7rayate}{\insrsid11288628 \emdash remain in; }{\cs337\i\insrsid11288628 h\'e5di}{\insrsid11288628 \emdash the heart.
