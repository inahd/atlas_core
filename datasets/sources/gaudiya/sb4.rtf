\insrsid11288628 \emdash by Your Lordship; }{\cs337\i\insrsid11288628 sukha-du\'f9kha}{\insrsid11288628 \emdash happiness and miseries; }{\cs337\i\insrsid11288628 hata-\'e4tman\'e4m}{\insrsid11288628 \emdash those who are affected; }{
\cs337\i\insrsid11288628 dar\'e7ita\'f9}{\insrsid11288628 \emdash shown; }{\cs337\i\insrsid11288628 k\'e5pay\'e4}{\insrsid11288628 \emdash by mercy; }{\cs337\i\insrsid11288628 pu\'e0s\'e4m}{\insrsid11288628 \emdash of the people; }{
