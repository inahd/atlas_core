\par \'e7atar\'fcp\'e4numodita\'f9
\par }\pard\plain \s394\qc \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0\pararsid11288628 \i\f35\fs28\cf1\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\insrsid11288628 
