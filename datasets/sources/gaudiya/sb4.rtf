\insrsid5197105 \emdash happiness; }{\cs337\i\insrsid5197105 du\'f9khe}{\insrsid5197105 \emdash and distress; }{\cs337\i\insrsid5197105 iti}{\insrsid5197105 \emdash thus; }{\cs337\i\insrsid5197105 dvandv\'e4ni}{\insrsid5197105 \emdash dualities; }{
\cs337\i\insrsid5197105 ajayat}{\insrsid5197105 \emdash he conquered; }{\cs337\i\insrsid5197105 sama-dar\'e7ana\'f9}{\insrsid5197105 \emdash equipoised.
\par }\pard \s268\qc \li0\ri0\sa180\nowidctlpar\faauto\rin0\lin0\itap0\pararsid10101918 {\b\cf11\insrsid10101918\charrsid3754542 TRANSLATION}{\insrsid10101918 
