\par }\pard\plain \s216\qj \fi357\li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0 \f35\fs28\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs383\cf1\insrsid5197105\charrsid5197105 In this verse the word }{\cs337\i\cf1\insrsid5197105 adhok\'f1aja,}{
