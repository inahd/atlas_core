the great sage Maitreya said; }{\cs337\i\insrsid11288628 evam}{\insrsid11288628 \emdash thus; }{\cs337\i\insrsid11288628 sa\'efjalpitam}{\insrsid11288628 \emdash spoken together; }{\cs337\i\insrsid11288628 m\'e4tu\'f9}{\insrsid11288628 \emdash 
from the mother; }{\cs337\i\insrsid11288628 \'e4kar\'ebya}{\insrsid11288628 \emdash hearing; }{\cs337\i\insrsid11288628 artha-\'e4gamam}{\insrsid11288628 \emdash purposeful; }{\cs337\i\insrsid11288628 vaca\'f9}{\insrsid11288628 \emdash words; }{
\cs337\i\insrsid11288628 sanniyamya}{\insrsid11288628 \emdash controlling; }{\cs337\i\insrsid11288628 \'e4tman\'e4}{\insrsid11288628 \emdash by the mind; }{\cs337\i\insrsid11288628 \'e4tm\'e4nam}{\insrsid11288628 \emdash own self; }{
\cs337\i\insrsid11288628 ni\'e7cakr\'e4ma}{\insrsid11288628 \emdash got out; }{\cs337\i\insrsid11288628 pitu\'f9}{\insrsid11288628 \emdash of the father; }{\cs337\i\insrsid11288628 pur\'e4t}{\insrsid11288628 \emdash from the house.
\par }\pard \s268\qc \li0\ri0\sa180\nowidctlpar\faauto\rin0\lin0\itap0\pararsid11288628 {\b\cf11\insrsid11288628\charrsid3754542 TRANSLATION}{\insrsid11288628 
