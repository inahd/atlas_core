\par }{\insrsid14643438 
\par }\pard\plain \s271\qj \li0\ri0\sb360\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \b\f35\fs28\cf11\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\v\insrsid5197105 SYNONYMS
