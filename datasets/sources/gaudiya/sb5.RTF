\cs409\fs28\insrsid11612319\charrsid12079977 \emdash King Par\'e9k\'f1it said; }{\cs410\i\insrsid11612319\charrsid4273542 priya-vrata\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash King Priyavrata; }{\cs410\i\insrsid11612319\charrsid4273542 bh
\'e4gavata\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash the great devotee; }{\cs410\i\insrsid11612319\charrsid4273542 \'e4tma-\'e4r\'e4ma\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash who takes pleasure in self-realization; }{
\cs410\i\insrsid11612319\charrsid4273542 katham}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash why; }{\cs410\i\insrsid11612319\charrsid4273542 mune}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash O great sage; }{
\cs410\i\insrsid11612319\charrsid4273542 g\'e5he}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash at home; }{\cs410\i\insrsid11612319\charrsid4273542 aramata}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash enjoyed; }{
\cs410\i\insrsid11612319\charrsid4273542 yat-m\'fcla\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash having which as the root cause; }{\cs410\i\insrsid11612319\charrsid4273542 karma-bandha\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 
\emdash the bondage of fruitive activities; }{\cs410\i\insrsid11612319\charrsid4273542 par\'e4bhava\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash the defeat of one's human mission.
