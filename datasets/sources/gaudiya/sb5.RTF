\cs410\i\insrsid11612319\charrsid4273542 te}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash your; }{\cs410\i\insrsid11612319\charrsid4273542 tata\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash father; }{
\cs410\i\insrsid11612319\charrsid4273542 e\'f1a\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash this; }{\cs410\i\insrsid11612319\charrsid4273542 mah\'e4-\'e5\'f1i\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash N\'e4rada; }{
