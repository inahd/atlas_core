\par }\pard\plain \s31\qj \li0\ri0\sb89\sa89\nowidctlpar\faauto\rin0\lin0\itap0\pararsid9535257 \f35\fs24\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\fs28\cf1\insrsid11612319 "One who acts to serve K\'e5\'f1\'eb
