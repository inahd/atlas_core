\cs410\i\insrsid11612319\charrsid4273542 t}{\cs410\i\insrsid15492700\charrsid4273542 a}{\cs410\i\insrsid11612319\charrsid4273542 ta}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash my dear son; }{\cs410\i\insrsid11612319\charrsid4273542 idam}{
\cs409\fs28\insrsid11612319\charrsid12079977 \emdash this; }{\cs410\i\insrsid11612319\charrsid4273542 \'e5tam}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash true; }{\cs410\i\insrsid11612319\charrsid4273542 brav\'e9mi}{
\cs409\fs28\insrsid11612319\charrsid12079977 \emdash I am speaking; }{\cs410\i\insrsid11612319\charrsid4273542 m\'e4}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash not; }{\cs410\i\insrsid11612319\charrsid4273542 as\'fcyitum}{
\cs409\fs28\insrsid11612319\charrsid12079977 \emdash to be jealous of; }{\cs410\i\insrsid11612319\charrsid4273542 devam}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash the Supreme Personality of Godhead; }{\cs410\i\insrsid11612319\charrsid4273542 
