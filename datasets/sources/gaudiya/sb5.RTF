\par }\pard\plain \s451\qc \li0\ri0\sb120\sa120\widctlpar\aspalpha\aspnum\faauto\adjustright\rin0\lin0\itap0\pararsid15405877 \b\f35\fs28\cf11\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\insrsid11612319 PURPORT
