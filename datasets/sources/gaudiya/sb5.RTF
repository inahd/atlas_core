\par }\pard\plain \s412\qj \li0\ri0\sb120\sa120\nowidctlpar\faauto\rin0\lin0\itap0\pararsid11098997 \f35\fs24\cf9\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs410\i\insrsid11612319\charrsid4273542 na}{\cs409\fs28\insrsid11612319\charrsid12079977 
\emdash never; }{\cs410\i\insrsid11612319\charrsid4273542 tasya}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash His; }{\cs410\i\insrsid11612319\charrsid4273542 ka\'e7cit}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash anyone; }{
