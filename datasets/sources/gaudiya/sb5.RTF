\cs337\i\fs28\insrsid11612319 yuga-anta-ar\'ebave}{\fs28\insrsid11612319 \emdash in the water of devastation at the end of the millennium; }{\cs337\i\fs28\insrsid11612319 \'fcrmi-m\'e4lini}{\fs28\insrsid11612319 \emdash possessing rows of big waves; }{
\cs337\i\fs28\insrsid11612319 k\'f1o\'eb\'e9m}{\fs28\insrsid11612319 \emdash the planet earth; }{\cs337\i\fs28\insrsid11612319 im\'e4m}{\fs28\insrsid11612319 \emdash this; }{\cs337\i\fs28\insrsid11612319 o\'f1adhi-v\'e9rudh\'e4m}{\fs28\insrsid11612319 
\emdash of all kinds of herbs and drugs; }{\cs337\i\fs28\insrsid11612319 nidhim}{\fs28\insrsid11612319 \emdash the storehouse; }{\cs337\i\fs28\insrsid11612319 may\'e4}{\fs28\insrsid11612319 \emdash me; }{\cs337\i\fs28\insrsid11612319 saha}{
\fs28\insrsid11612319 \emdash with; }{\cs337\i\fs28\insrsid11612319 uru}{\fs28\insrsid11612319 \emdash great; }{\cs337\i\fs28\insrsid11612319 kramate}{\fs28\insrsid11612319 \emdash You roamed; }{\cs337\i\fs28\insrsid11612319 aja}{\fs28\insrsid11612319 
\emdash O unborn one; }{\cs337\i\fs28\insrsid11612319 ojas\'e4}{\fs28\insrsid11612319 \emdash with speed; }{\cs337\i\fs28\insrsid11612319 tasmai}{\fs28\insrsid11612319 \emdash unto Him; }{\cs337\i\fs28\insrsid11612319 jagat}{\fs28\insrsid11612319 \emdash 
