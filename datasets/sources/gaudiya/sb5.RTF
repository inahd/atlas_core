\cs409\fs28\insrsid11612319\charrsid12079977 \emdash is covered; }{\cs410\i\insrsid11612319\charrsid4273542 pr\'e9ti\'f9}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash love; }{\cs410\i\insrsid11612319\charrsid4273542 na}{
\cs409\fs28\insrsid11612319\charrsid12079977 \emdash not; }{\cs410\i\insrsid11612319\charrsid4273542 y\'e4vat}{\cs409\fs28\insrsid11612319\charrsid12079977 \emdash as long as; }{\cs410\i\insrsid11612319\charrsid4273542 mayi}{
