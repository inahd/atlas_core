\cs337\i\fs28\insrsid11612319 loka-p\'e4l\'e4\'f9}{\fs28\insrsid11612319 \emdash the great leaders of the universe, beginning with Lord Brahm\'e4; }{\cs337\i\fs28\insrsid11612319 kila}{\fs28\insrsid11612319 \emdash what to speak of others; }{
\cs337\i\fs28\insrsid11612319 matsara-jvar\'e4\'f9}{\fs28\insrsid11612319 \emdash who are suffering from the fever of envy; }{\cs337\i\fs28\insrsid11612319 hitv\'e4}{\fs28\insrsid11612319 \emdash leaving aside; }{\cs337\i\fs28\insrsid11612319 yatanta\'f9}
{\fs28\insrsid11612319 \emdash endeavoring; }{\cs337\i\fs28\insrsid11612319 api}{\fs28\insrsid11612319 \emdash although; }{\cs337\i\fs28\insrsid11612319 p\'e5thak}{\fs28\insrsid11612319 \emdash separately; }{\cs337\i\fs28\insrsid11612319 sametya}{
\fs28\insrsid11612319 \emdash combined; }{\cs337\i\fs28\insrsid11612319 ca}{\fs28\insrsid11612319 \emdash also; }{\cs337\i\fs28\insrsid11612319 p\'e4tum}{\fs28\insrsid11612319 \emdash to protect; }{\cs337\i\fs28\insrsid11612319 na}{\fs28\insrsid11612319 
\emdash not; }{\cs337\i\fs28\insrsid11612319 \'e7eku\'f9}{\fs28\insrsid11612319 \emdash able; }{\cs337\i\fs28\insrsid11612319 dvi-pada\'f9}{\fs28\insrsid11612319 \emdash two-legged; }{\cs337\i\fs28\insrsid11612319 catu\'f9-pada\'f9}{\fs28\insrsid11612319 
