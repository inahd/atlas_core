\par }\pard\plain \s908\qj \fi369\li0\ri0\sa86\nowidctlpar\faauto\rin0\lin0\itap0 \f35\fs24\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs3006\fs28\cf1\insrsid10252087\charrsid3824524 Elsewhere in the }{\cs2542\i\fs28\cf1\insrsid10252087 G\'e9t\'e4}{
