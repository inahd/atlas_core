\line Na b]\'f8<aae Na Tau >avSYa Na vE rMaaYaa\line  YaNMae_iPaRTa" iXariSa Pa\'dak-r" Pa[Saad" )) 26 ))
\par }\pard\plain \s23\qc \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0 \i\f35\fs28\cf1\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\insrsid30033 kv\'e4ha\'e0 raja\'f9-prabhava \'e9\'e7a tamo 'dhike 'smin
