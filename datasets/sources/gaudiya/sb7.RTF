\par }\pard\plain \s23\qc \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0 \i\f35\fs28\cf1\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\insrsid30033 indriy\'e4\'ebi mana\'f9 pr\'e4\'eba
