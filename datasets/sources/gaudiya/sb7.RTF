\par }\pard\plain \s1140\qj \fi369\li0\ri0\sb120\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \f35\fs24\cf9\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs1998\i\fs28\insrsid30033 ka\'f9}{\fs28\insrsid30033 \emdash what is that; }{
