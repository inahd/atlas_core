\par }\pard\plain \s1428\qc \li0\ri0\nowidctlpar\faauto\rin0\lin0\itap0 \i\f35\fs24\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\fs28\cf1\insrsid30033 \'e7r\'e9-n\'e4rada uv\'e4ca
