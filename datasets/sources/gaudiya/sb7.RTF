the supreme controller; }{\cs1998\i\fs28\insrsid30033 s\'e5jati}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash creates; }{\cs1998\i\fs28\insrsid30033 idam}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash this (material world); }{
\cs1998\i\fs28\insrsid30033 avyaya\'f9}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash remaining as He is (not having lost His own existence because of having created so many material manifestations); }{\cs1998\i\fs28\insrsid30033 ya\'f9}{
\cs2996\fs28\insrsid30033\charrsid11368625 \emdash who; }{\cs1998\i\fs28\insrsid30033 eva}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash indeed; }{\cs1998\i\fs28\insrsid30033 rak\'f1ati}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash maintains; }
{\cs1998\i\fs28\insrsid30033 avalumpate}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash annihilates; }{\cs1998\i\fs28\insrsid30033 ca}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash also; }{\cs1998\i\fs28\insrsid30033 ya\'f9}{
