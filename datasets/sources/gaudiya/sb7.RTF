tm\'e4}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash the soul; }{\cs1998\i\fs28\insrsid30033 t\'e4vat}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash that long; }{\cs1998\i\fs28\insrsid30033 karma}{\cs2996\fs28\insrsid30033\charrsid11368625 
\emdash of fruitive activities; }{\cs1998\i\fs28\insrsid30033 nibandhanam}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash bondage; }{\cs1998\i\fs28\insrsid30033 tata\'f9}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash from that; }{
\cs1998\i\fs28\insrsid30033 viparyaya\'f9}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash reversal (wrongly thinking the body to be the self); }{\cs1998\i\fs28\insrsid30033 kle\'e7a\'f9}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash misery; }{
\cs1998\i\fs28\insrsid30033 m\'e4y\'e4-yoga\'f9}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash a strong relationship with the external, illusory energy; }{\cs1998\i\fs28\insrsid30033 anuvartate}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash 
