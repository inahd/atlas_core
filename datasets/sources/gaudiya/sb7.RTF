\cs2996\fs28\insrsid30033\charrsid11368625  (\'c7ukadeva); }{\cs1998\i\fs28\insrsid30033 bh\'fct\'e4n\'e4m}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash toward all living entities; }{\cs1998\i\fs28\insrsid30033 bhagav\'e4n}{
\cs2996\fs28\insrsid30033\charrsid11368625 \emdash the Supreme Lord, Vi\'f1\'ebu; }{\cs1998\i\fs28\insrsid30033 svayam}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash Himself; }{\cs1998\i\fs28\insrsid30033 indrasya}{
\cs2996\fs28\insrsid30033\charrsid11368625 \emdash of Indra; }{\cs1998\i\fs28\insrsid30033 arthe}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash for the benefit; }{\cs1998\i\fs28\insrsid30033 katham}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash 
how; }{\cs1998\i\fs28\insrsid30033 daity\'e4n}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash the demons; }{\cs1998\i\fs28\insrsid30033 avadh\'e9t}{\cs2996\fs28\insrsid30033\charrsid11368625 \emdash killed; }{\cs1998\i\fs28\insrsid30033 vi\'f1ama\'f9}
