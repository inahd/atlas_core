\par }\pard\plain \s1467\qr \li0\ri0\sb240\nowidctlpar\faauto\rin0\lin0\itap0 \v\f35\fs20\cf11\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\insrsid30033 SB 7.9.48
