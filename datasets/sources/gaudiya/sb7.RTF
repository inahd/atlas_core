\par }\pard\plain \s1140\qj \fi369\li0\ri0\sb120\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \f35\fs24\cf9\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs1998\i\fs28\insrsid30033 \'e7r\'e9-yudhi\'f1\'f6hira\'f9 uv\'e4ca}{\fs28\insrsid30033 \emdash Mah\'e4r
\'e4ja Yudhi\'f1\'f6hira inquired; }{\cs1998\i\fs28\insrsid30033 bhagavan}{\fs28\insrsid30033 \emdash O my lord; }{\cs1998\i\fs28\insrsid30033 \'e7rotum}{\fs28\insrsid30033 \emdash to hear; }{\cs1998\i\fs28\insrsid30033 icch\'e4mi}{\fs28\insrsid30033 
\emdash I wish; }{\cs1998\i\fs28\insrsid30033 n\'e5\'eb\'e4m}{\fs28\insrsid30033 \emdash of human society; }{\cs1998\i\fs28\insrsid30033 dharmam}{\fs28\insrsid30033 \emdash the occupational duties; }{\cs1998\i\fs28\insrsid30033 san\'e4tanam}{
\fs28\insrsid30033 \emdash common and eternal (for everyone); }{\cs1998\i\fs28\insrsid30033 var\'eba-\'e4\'e7rama-\'e4c\'e4ra-yutam}{\fs28\insrsid30033 \emdash 
based on the principles of the four divisions of society and the four divisions of spiritual advancement; }{\cs1998\i\fs28\insrsid30033 yat}{\fs28\insrsid30033 \emdash from which; }{\cs1998\i\fs28\insrsid30033 pum\'e4n}{\fs28\insrsid30033 \emdash 
the people in general; }{\cs1998\i\fs28\insrsid30033 vindate}{\fs28\insrsid30033 \emdash can enjoy very peacefully; }{\cs1998\i\fs28\insrsid30033 param}{\fs28\insrsid30033 \emdash the supreme knowledge (by which one can attain devotional service).
\par }\pard\plain \s1187\qc \li0\ri0\sb360\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \b\v\f35\fs24\cf11\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\v0\fs28\insrsid30033 TRANSLATION
