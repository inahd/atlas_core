\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash by the three modes of material nature; }{\cs1998\i\fs28\insrsid4605116 vivarjit\'e4ya}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash who are not contaminated; }{\cs1998\i\fs28\insrsid4605116 mukta-
\'e4tmabhi\'f9}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash by persons who are already liberated; }{\cs1998\i\fs28\insrsid4605116 sva-h\'e5daye}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash within the core of the heart; }{
\cs1998\i\fs28\insrsid4605116 paribh\'e4vit\'e4ya}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash unto You, who are always meditated upon; }{\cs1998\i\fs28\insrsid4605116 j\'ef\'e4na-\'e4tmane}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash 
