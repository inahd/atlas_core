\cs1998\i\fs28\insrsid4605116 sam\'e4hitam}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash concentrated the mind (without being agitated by material conditions); }{\cs1998\i\fs28\insrsid4605116 d\'e5\'f1\'f6v\'e4}{
\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash upon seeing (him); }{\cs1998\i\fs28\insrsid4605116 asur\'e4\'f9}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash the demons; }{\cs1998\i\fs28\insrsid4605116 y\'e4tudh\'e4n\'e4\'f9}{
\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash the R\'e4k\'f1asas; }{\cs1998\i\fs28\insrsid4605116 jagdhum}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash desired to devour; }{\cs1998\i\fs28\insrsid4605116 abhyadravan}{
\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash running very fast; }{\cs1998\i\fs28\insrsid4605116 k\'f1udh\'e4}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash to satisfy their appetite.
