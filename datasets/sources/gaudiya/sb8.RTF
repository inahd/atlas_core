\par }\pard\plain \s1462\qc \li0\ri0\sb180\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \i\f35\fs24\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\fs28\cf1\insrsid4605116 yasy\'e4tma-buddhi\'f9 ku\'ebape tri-dh\'e4tuke\line sva-dh\'e9\'f9 kalatr\'e4di\'f1
