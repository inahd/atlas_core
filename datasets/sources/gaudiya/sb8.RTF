\par }\pard\plain \s1187\qc \li0\ri0\sb360\sa180\nowidctlpar\faauto\rin0\lin0\itap0 \b\v\f35\fs24\cf11\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\v0\fs28\insrsid4605116\charrsid9243408 PURPORT}{\v0\fs28\insrsid4605116 
