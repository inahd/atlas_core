\cs1998\i\fs28\insrsid4605116 \'e4s\'e4m cak\'e4ra}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash situated; }{\cs1998\i\fs28\insrsid4605116 upa-supar\'ebam}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash on the back of Garu\'f2a; }{
\cs1998\i\fs28\insrsid4605116 enam}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash Him; }{\cs1998\i\fs28\insrsid4605116 up\'e4sate}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash worship; }{\cs1998\i\fs28\insrsid4605116 yoga-rathena}{
