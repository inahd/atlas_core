\par }\pard\plain \s1140\qj \fi340\li0\ri0\sb120\sa60\nowidctlpar\faauto\rin0\lin0\itap0 \f35\fs24\cf9\lang2057\langfe2057\cgrid\langnp2057\langfenp2057 {\cs1998\i\fs28\insrsid4605116 tam}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash O Lord; }{
\cs1998\i\fs28\insrsid4605116 tv\'e4m}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash Your Lordship; }{\cs1998\i\fs28\insrsid4605116 vayam}{\cs3010\fs28\insrsid4605116\charrsid6049549 \emdash all of us; }{\cs1998\i\fs28\insrsid4605116 n\'e4tha}{
